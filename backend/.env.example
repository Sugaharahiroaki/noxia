# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Next.js 開発サーバー(プロキシ元)のオリジン
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
REAUTH_VALID_MINUTES=10
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=yorumiru
POSTGRES_USER=yorumiru
POSTGRES_PASSWORD=yorumiru
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_yorumiru

# --- 開発用データ ---
# 1 のとき `manage.py seed_dev` で開発用の会社・店舗・ユーザーを投入できる（本番では 0）
ALLOW_DEV_SEED=1

# --- LINE 公式アカウント連携 ---
# 実際の送信を許可するか。開発・テスト中は必ず 0（モック送信のみ）
LINE_SEND_ENABLED=0

# --- カード決済端末 ---
# 1 のときだけ本番の決済会社（実際にお金が動く）へ送信する。開発・テストは 0（模擬端末・Square Sandbox は使える）
CARD_TERMINAL_LIVE_ENABLED=0
# 模擬端末（画面で承認・拒否を選ぶテスト用）を使えるか。未指定なら DJANGO_DEBUG と同じ。本番は 0 にする
# CARD_TERMINAL_MOCK_ENABLED=0

# --- フィールド暗号化（freee/Square トークン・申告の入力・原本ファイル） ---
# base64 の 32 バイト。生成例: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 本番（DJANGO_DEBUG=0）では必須。鍵は DB・ファイルのバックアップとは別の場所に保管する。鍵の交換は V2 を足して ACTIVE_VERSION を 2 にする
# FIELD_ENCRYPTION_KEY_V1=
# FIELD_ENCRYPTION_ACTIVE_VERSION=1

# --- 領収書の AI 読取（会社設定で有効にした会社だけ呼ぶ） ---
# mock: 固定結果（開発・テスト）/ anthropic: Claude の画像・PDF 直読み
RECEIPT_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# RECEIPT_AI_MODEL=claude-sonnet-5-5
# RECEIPT_AI_FALLBACK_MODEL=claude-opus-5-5

# --- 確定申告: XTX（e-Tax 申告データ）を利用者に公開する年度（公式ソフトでの取込試験に合格した年度だけ。カンマ区切り） ---
# TAX_XTX_RELEASED_YEARS=
# TAX_XTX_SCHEMA_DIR=/path/to/etax-xsd
