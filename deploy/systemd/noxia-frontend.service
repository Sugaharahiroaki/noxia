[Unit]
Description=NOXIA frontend (Next.js)
After=network.target noxia-backend.service

[Service]
User=noxia
Group=noxia
WorkingDirectory=/srv/noxia/current/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/srv/noxia/current/frontend/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
