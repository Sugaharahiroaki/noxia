[Unit]
Description=NOXIA backend (Django / gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=noxia
Group=noxia
WorkingDirectory=/srv/noxia/current/backend
ExecStart=/srv/noxia/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
