[Unit]
Description=NOXIA background jobs (AI 読取・CSV 解析)
After=network.target postgresql.service

[Service]
User=noxia
Group=noxia
WorkingDirectory=/srv/noxia/current/backend
ExecStart=/srv/noxia/venv/bin/python manage.py run_jobs --loop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
